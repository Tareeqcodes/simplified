# Copy this file to .env.local and fill it in.
# .env.example is only a template — Next.js does NOT read it.

# Public origin of the deployed site, e.g. https://simplified.appwrite.network
# Used to make share links and the Open Graph image absolute. Must be present at
# BUILD time (it's a NEXT_PUBLIC_ var). Falls back to localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which model vendor to use. Default is gemini (free tier), for both dev and the
# public deployment. Set AI_PROVIDER=claude only when you have Anthropic credit.
AI_PROVIDER=gemini

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-job overrides
# CLAUDE_MODEL_DIGEST=claude-opus-5
# CLAUDE_MODEL_OUTLINE=claude-sonnet-5
# CLAUDE_MODEL_ASK=claude-sonnet-5

# --- Gemini (aistudio.google.com) — free tier for the public build ---
GEMINI_API_KEY=
# Defaults use the rolling "-latest" alias so a retirement can't break the app.
# Pin a version if you prefer, e.g. gemini-3.5-flash.
# GEMINI_MODEL_DIGEST=gemini-flash-latest
# GEMINI_MODEL_OUTLINE=gemini-flash-latest   # gemini-flash-lite-latest is cheaper/faster
# GEMINI_MODEL_ASK=gemini-flash-latest
# Thinking budget for the section rewrite. 128 (default) keeps it fast; raise it
# (e.g. 512) if quality dips. Current models reject 0. Outline/grading use 128.
# GEMINI_SECTION_THINKING=128

# --- Appwrite ---
# Endpoint and project ID are client-safe; the API key is NOT.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT=
# Server key with `databases` scope — needed to provision collections and to
# enforce quota server-side. Never expose this to the browser.
APPWRITE_DB=
APPWRITE_API_KEY=

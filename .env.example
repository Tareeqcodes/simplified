# Copy this file to .env.local and fill it in.
# .env.example is only a template — Next.js does NOT read it.

# Which model vendor to use: claude (local dev) or gemini (public deployment)
AI_PROVIDER=claude

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-job overrides
# CLAUDE_MODEL_DIGEST=claude-opus-5
# CLAUDE_MODEL_OUTLINE=claude-sonnet-5
# CLAUDE_MODEL_ASK=claude-sonnet-5

# --- Gemini (aistudio.google.com) — free tier for the public build ---
GEMINI_API_KEY=
# GEMINI_MODEL_DIGEST=gemini-2.5-flash
# GEMINI_MODEL_OUTLINE=gemini-2.5-flash
# GEMINI_MODEL_ASK=gemini-2.5-flash

# --- Appwrite ---
# Endpoint and project ID are client-safe; the API key is NOT.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT=
# Server key with `databases` scope — needed to provision collections and to
# enforce quota server-side. Never expose this to the browser.
APPWRITE_DB=
APPWRITE_API_KEY=
